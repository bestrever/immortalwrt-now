# 京东云雅典娜 JDCloud RE-CS-02 (qualcommax/ipq60xx, IPQ6010) .config — 全插件 + USB 网卡 + Argon 皮肤
# 注意分支：RE-CS-02 在 ImmortalWrt openwrt-24.10 里没有设备 profile（24.10 的 ipq60xx.mk
# 只有 4 个设备、无 jdcloud、无对应 DTS），仅 master 分支有 jdcloud_re-cs-02。
# 因此本目标在 workflow 里默认走 master 分支；如用户决定不编雅典娜或换 NSS 源，改 workflow 的 athena 项即可。
# WiFi 固件/驱动按 RE-CS-02 设备包补齐：ipq-wifi + ath11k 固件/驱动；athena-led 如 feeds 里没有会被 defconfig 丢掉，不校验。

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y

# LuCI + iStoreOS 皮肤：Argon 主题 + Argon 配置
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-opkg=y

# 代理 / DNS（同 x86_64 清单）
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-ssr-plus=y

# WiFi（RE-CS-02：QCN5022/QCN5052/QCN9024，ath11k）
CONFIG_PACKAGE_ipq-wifi-jdcloud_re-cs-02=y
CONFIG_PACKAGE_ath11k-firmware-qcn9074=y
CONFIG_PACKAGE_kmod-ath11k-pci=y

# USB 网卡驱动（随身 WiFi 用，同 x86_64 清单；只校验 rndis）
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_kmod-usb-storage=y

# 常用工具
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_luci-app-ttyd=y
