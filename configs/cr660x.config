# 小米 CR660x (ramips/mt7621, MT7621AT, 256MB/128MB NAND) .config — PassWall2 + MosDNS
# 用户定：CR660x 只装一个 PassWall2，不用 USB 网卡驱动，不用 iStoreOS/Argon 皮肤；
# 2026-10-28 23:11 用户加 MosDNS 插件（USB/皮肤仍不加）。
# 三个运营商变体同硬件，只差 DTS 型号名，三个 device 全选，产出三份镜像，按机身型号选。
# 分支 openwrt-24.10；CR6606/6608/6609 已在 24.10 的 ramips/mt7621.mk 里核实存在。
# 保持最小化：默认 Bootstrap 主题，除 PassWall2 与 MosDNS 外不加其他代理/DNS/USB 包，省闪存和内存。

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
# run #5 教训：CONFIG_TARGET_DEVICE_… 设备行属于 “Target Devices” 菜单（scripts/target-metadata.pl 生成），
# 只在 CONFIG_TARGET_MULTI_PROFILE=y 时才生效；没开它 make defconfig 会把设备行丢掉，
# Load 步骤报 MISSING device。三个变体同编也必须走多设备模式（单选 Target Profile 一次只能选一台）。
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6606=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6608=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6609=y

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-mosdns=y
