# NanoPi R4S (rockchip/armv8, RK3399) .config — 全插件 + USB 网卡 + Argon 皮肤
# 分支 openwrt-24.10；设备 profile friendlyarm_nanopi-r4s 已在 24.10 的 rockchip/armv8.mk 里核实存在。
# 其余说明同 x86_64.config。R4S 无 WiFi，不加无线包；有线用默认 r8169 驱动，不替换 r8168。

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
# run #5 教训：CONFIG_TARGET_DEVICE_… 设备行属于 “Target Devices” 菜单（scripts/target-metadata.pl 生成），
# 只在 CONFIG_TARGET_MULTI_PROFILE=y 时才生效；没开它 make defconfig 会把设备行丢掉，
# Load 步骤报 MISSING device。x86_64 用的是单选 Target Profile 形式，所以不受影响。
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r4s=y

# LuCI + iStoreOS 皮肤：Argon 主题 + Argon 配置
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-opkg=y

# 代理 / DNS（同 x86_64 清单）
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-ssr-plus=y

# Docker（用户定：R4S 支持 docker，储存空间由 workflow 下拉框选）
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-app-dockerman=y

# USB 网卡驱动（随身 WiFi 用，同 x86_64 清单；只校验 rndis）
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_kmod-usb-storage=y

# 常用工具
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_luci-app-ttyd=y
